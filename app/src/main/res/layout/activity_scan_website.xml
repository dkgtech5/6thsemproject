<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan Website"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Enter the website URL to analyze"
                android:textColor="#64748B"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvUrlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Enter Website URL"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescription" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_background"
                app:layout_constraintTop_toBottomOf="@id/tvUrlLabel">

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="https://example.com"
                    android:inputType="textUri"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/btnClear"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/btnClear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_error"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#64748B" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnAnalyze"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary"
                android:text="Analyze"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/layoutInput" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/btnAnalyze"
                app:layout_constraintEnd_toEndOf="@id/btnAnalyze"
                app:layout_constraintStart_toStartOf="@id/btnAnalyze"
                app:layout_constraintTop_toTopOf="@id/btnAnalyze" />

            <TextView
                android:id="@+id/tvExampleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="40dp"
                android:text="Example URLs"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnAnalyze" />

            <LinearLayout
                android:id="@+id/llExamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvExampleLabel">

                <!-- Example 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon1" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="https://esewa.com.np" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron1" app:layout_constraintStart_toEndOf="@id/ivExampleIcon1" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron1" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon2" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="https://khalti.com" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron2" app:layout_constraintStart_toEndOf="@id/ivExampleIcon2" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron2" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 3 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon3" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="http://esewa-kyc-update-login.com" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron3" app:layout_constraintStart_toEndOf="@id/ivExampleIcon3" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron3" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 4 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon4" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="http://khalti-verify-account.net" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron4" app:layout_constraintStart_toEndOf="@id/ivExampleIcon4" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron4" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 5 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon5" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="http://paypal-security-alert-update.com/login.php" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron5" app:layout_constraintStart_toEndOf="@id/ivExampleIcon5" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron5" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 6 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon6" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="http://192.168.1.1/login-facebook-verify.html" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron6" app:layout_constraintStart_toEndOf="@id/ivExampleIcon6" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron6" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Example 7 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemExample7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivExampleIcon7" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_globe" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                    <TextView android:id="@+id/tvExample7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="https://ncit.edu.np/" android:textColor="#0F172A" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/ivChevron7" app:layout_constraintStart_toEndOf="@id/ivExampleIcon7" app:layout_constraintTop_toTopOf="parent" />
                    <ImageView android:id="@+id/ivChevron7" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#64748B" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>